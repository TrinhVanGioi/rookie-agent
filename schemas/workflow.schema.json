{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rookie-agent.local/schemas/workflow.schema.json",
  "title": "Workflow",
  "description": "Quy trình đã tổng quát hoá. Xem docs/design.md mục 4.3.",
  "type": "object",
  "required": [
    "schema_version",
    "engine",
    "id",
    "version",
    "status",
    "inputs",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3,
        4
      ],
      "description": "1: web và java. 2: thêm engine ie (trang web trong Internet Explorer, đọc bằng COM). 3: thêm bước tuỳ chọn (step.optional) và đầu vào không bắt buộc (input.required). Bản 1 và 2 vẫn hợp lệ. 4 (chỉ engine ie): bước có intent, expect (hậu kiểm) và adapt (tự tìm lại mục tiêu), xem docs/design.md mục 15."
    },
    "engine": {
      "enum": [
        "web",
        "java",
        "ie"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "tested",
        "approved"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "enum": [
              "date",
              "number",
              "string"
            ]
          },
          "value_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "default": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean",
            "description": "Chỉ từ schema_version 3. false: người chạy có thể để trống (ví dụ role, khi màn hình đã có sẵn giá trị mặc định). Chỉ dùng cho đầu vào của bước optional if_different."
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "risk",
          "mode"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "goto",
              "click",
              "fill",
              "select",
              "submit",
              "read_value",
              "wait_for",
              "extract_table",
              "read_fields",
              "compare",
              "save"
            ]
          },
          "target": {
            "type": "object",
            "required": [
              "selectors"
            ],
            "additionalProperties": false,
            "properties": {
              "selectors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tag": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "url": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "save_as": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key": {
            "type": "string"
          },
          "tolerance": {
            "type": [
              "string",
              "number"
            ]
          },
          "risk": {
            "enum": [
              "read",
              "write",
              "money"
            ]
          },
          "mode": {
            "enum": [
              "auto",
              "review",
              "approve"
            ]
          },
          "optional": {
            "type": "object",
            "description": "Chỉ từ schema_version 3. if_different: ô chọn hoặc ô nhập chỉ làm khi người chạy có nhập giá trị. if_present: nút chỉ bấm nếu có trên màn hình. Không bao giờ dùng cho bước write hoặc money.",
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "if_different",
                  "if_present"
                ]
              },
              "wait_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              }
            }
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Từ schema_version 4: việc nghiệp vụ của bước, bằng lời của màn hình."
          },
          "expect": {
            "type": "object",
            "required": [
              "appears"
            ],
            "additionalProperties": false,
            "description": "Từ schema_version 4: hậu kiểm. Những gì phải hiện sau bước (khung, loại, tên), không có giá trị.",
            "properties": {
              "appears": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "frame",
                    "kind",
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "frame": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "kind": {
                      "enum": [
                        "field",
                        "table",
                        "message"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 60,
                      "description": "Nhãn ô hoặc id bảng, đã che số; thông báo không giữ chữ (rỗng)."
                    }
                  }
                }
              }
            }
          },
          "adapt": {
            "type": "object",
            "required": [
              "reresolve"
            ],
            "additionalProperties": false,
            "description": "Từ schema_version 4: chính sách thích nghi. reresolve: agent được tự tìm lại mục tiêu khi giao diện đổi (chỉ bước read, luôn hậu kiểm).",
            "properties": {
              "reresolve": {
                "type": "boolean"
              }
            }
          }
        },
        "allOf": [
          {
            "description": "optional if_present: chỉ một cú bấm chỉ xem.",
            "if": {
              "required": [
                "optional"
              ],
              "properties": {
                "optional": {
                  "properties": {
                    "mode": {
                      "const": "if_present"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "action": {
                  "const": "click"
                },
                "risk": {
                  "const": "read"
                }
              },
              "required": [
                "risk"
              ]
            }
          },
          {
            "description": "optional if_different: chọn hoặc nhập, chỉ xem.",
            "if": {
              "required": [
                "optional"
              ],
              "properties": {
                "optional": {
                  "properties": {
                    "mode": {
                      "const": "if_different"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "action": {
                  "enum": [
                    "fill",
                    "select"
                  ]
                },
                "risk": {
                  "const": "read"
                }
              },
              "required": [
                "risk"
              ]
            }
          },
          {
            "description": "Bước money không bao giờ là auto.",
            "if": {
              "required": [
                "risk"
              ],
              "properties": {
                "risk": {
                  "const": "money"
                }
              }
            },
            "then": {
              "properties": {
                "mode": {
                  "enum": [
                    "review",
                    "approve"
                  ]
                }
              }
            }
          },
          {
            "description": "Bước write luôn là approve.",
            "if": {
              "required": [
                "risk"
              ],
              "properties": {
                "risk": {
                  "const": "write"
                }
              }
            },
            "then": {
              "properties": {
                "mode": {
                  "const": "approve"
                }
              }
            }
          },
          {
            "description": "Các action thao tác trên phần tử phải có target.",
            "if": {
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "enum": [
                    "click",
                    "fill",
                    "select",
                    "submit",
                    "read_value",
                    "wait_for",
                    "extract_table"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "target"
              ]
            }
          },
          {
            "description": "read_value và extract_table phải đặt tên biến.",
            "if": {
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "enum": [
                    "read_value",
                    "extract_table"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "save_as"
              ]
            }
          },
          {
            "description": "Chỉ bước read mới được tự tìm lại mục tiêu.",
            "if": {
              "required": [
                "adapt"
              ],
              "properties": {
                "adapt": {
                  "properties": {
                    "reresolve": {
                      "const": true
                    }
                  },
                  "required": [
                    "reresolve"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "risk": {
                  "const": "read"
                }
              },
              "required": [
                "risk"
              ]
            }
          }
        ]
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  },
  "allOf": [
    {
      "description": "engine ie chỉ có từ schema_version 2.",
      "if": {
        "required": [
          "engine"
        ],
        "properties": {
          "engine": {
            "const": "ie"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              2,
              3,
              4
            ]
          }
        }
      }
    },
    {
      "description": "schema_version 4 chỉ có ở engine ie.",
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": 4
          }
        }
      },
      "then": {
        "properties": {
          "engine": {
            "const": "ie"
          }
        }
      }
    }
  ]
}